             "type": "number"
            }
           }
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "Default Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "error": {
           "type": "object",
           "properties": {
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "traceId": {
             "type": "string"
            },
            "details": {}
           },
           "required": [
            "code",
