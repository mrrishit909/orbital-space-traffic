  "/v1/conjunctions/{id}/maneuver-scenarios": {
   "post": {
    "summary": "Plan avoidance burns (simulation only) and re-screen each new orbit",
    "tags": [
     "maneuvers"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "targetPc": {
          "type": "number",
          "minimum": 1e-9,
          "maximum": 0.001
         },
         "notBefore": {
          "type": "string",
          "format": "date-time"
         }
        }
       }
      }
     }
    },
    "parameters": [
     {
      "schema": {
       "type": "string"
      },
      "in": "path",
      "name": "id",
      "required": true
     },
     {
      "schema": {
       "type": "string",
       "minLength": 8,
       "maxLength": 128
      },
      "in": "header",
      "name": "idempotency-key",
      "required": true
     }
    ],
    "security": [
     {
      "bearer": []
     }
    ],
    "responses": {
     "201": {
      "description": "Default Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "conjunctionId": {
           "type": "string"
          },
          "options": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": true
           }
          },
          "rejected": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": true
           }
          },
          "frontier": {
           "type": "integer"
          },
          "maneuverIds": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Default Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "error": {
           "type": "object",
           "properties": {
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "traceId": {
             "type": "string"
            },
            "details": {}
           },
           "required": [
            "code",
            "message"
           ]
          }
         },
         "required": [
          "error"
         ]
        }
       }
